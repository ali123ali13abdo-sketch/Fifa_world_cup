    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#FFF4D6"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0B2239"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
