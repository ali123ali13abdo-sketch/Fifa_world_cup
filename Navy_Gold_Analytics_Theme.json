        "*": [
          {
            "$id": "default",
            "paddingUniform": 8
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#102F4A"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#31546D"
              }
            },
            "radius": 4
          }
        ],
        "*": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 11
          }
        ]
      }
    }
